# Dependencies
node_modules/

# Build output
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# IDE
.idea/
.vscode/

# macOS
.DS_Store

# Secrets / environnement local
.env
.env.*
!.env.example

# Clés et identifiants. Un secret poussé sur un dépôt public ne se répare pas
# en le supprimant : il est dans l'historique et dans chaque clone, il faut le
# renouveler. `pnpm check no-secrets` refuse ceux qui passeraient quand même.
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
.netrc
.npmrc
credentials.json
service-account*.json

# Python bytecode from the minimal reader
__pycache__/

# The assembled site deployment, built by site/deploy/build-release.sh
site/release/
# Copied into the site at build time from examples/ and schema/
site/public/examples/
site/public/schema/
site/src/generated/
