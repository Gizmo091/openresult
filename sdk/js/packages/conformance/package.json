{
  "name": "@openresult/conformance",
  "version": "0.1.0",
  "description": "Runner for the language-agnostic OpenResult conformance suite.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@openresult/core": "workspace:*",
    "@openresult/validate": "workspace:*"
  }
}
