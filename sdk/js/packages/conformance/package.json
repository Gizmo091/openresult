{
  "name": "@openresult/conformance",
  "version": "1.0.1",
  "description": "Runner for the language-agnostic OpenResult conformance suite.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gizmo091/openresult.git",
    "directory": "sdk/js/packages/conformance"
  },
  "homepage": "https://openresult.dev",
